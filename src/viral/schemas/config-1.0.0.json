{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viral/config-1.0.0",
  "title": "VIRAL experiment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_schema_version", "experiment_id", "mode", "label", "master_seed", "n", "mean_degree", "ws_beta", "topologies", "models", "seed_rules", "seed_counts", "replicates", "cascades"],
  "properties": {
    "config_schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{3}$"},
    "mode": {"enum": ["exploratory", "confirmatory"]},
    "label": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "master_seed": {"type": "integer", "minimum": 0},
    "n": {"type": "integer", "minimum": 3},
    "mean_degree": {"type": "number", "exclusiveMinimum": 0},
    "ws_beta": {"type": "number", "minimum": 0, "maximum": 1},
    "topologies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["er", "ws", "ba"]}},
    "models": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ic": {"type": "object", "additionalProperties": false, "required": ["p"], "properties": {"p": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "lt": {"type": "object", "additionalProperties": false, "required": ["phi"], "properties": {"phi": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "minimum": 0}}}}
      }
    },
    "seed_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["random", "highest_degree"]}},
    "seed_counts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "replicates": {"type": "integer", "minimum": 1},
    "cascades": {"type": "integer", "minimum": 1},
    "verify": {"type": "boolean"},
    "engine": {"enum": ["vectorised", "reference"]}
  }
}
